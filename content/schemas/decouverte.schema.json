{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jdpbc/schemas/decouverte.schema.json",
  "title": "Découverte du parcours (un piège à démasquer)",
  "type": "object",
  "required": ["id", "nom", "latin", "emoji", "couleur", "taille", "anecdotes", "quiz", "pedagogie"],
  "additionalProperties": true,
  "properties": {
    "type": { "const": "decouverte" },
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "nom": { "type": "string", "minLength": 1 },
    "latin": { "type": "string", "minLength": 1 },
    "emoji": { "type": "string" },
    "couleur": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "categorie": { "enum": ["diurne", "nocturne"] },
    "taille": { "type": "string", "description": "Antidote affiché" },
    "img": { "type": "string", "description": "Chemin relatif d'une photo optionnelle" },
    "audioFile": { "type": ["string", "null"], "description": "Son réel optionnel, sinon signature synthétique" },
    "anecdotes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    },
    "chant": {
      "type": ["object", "null"],
      "description": "Signature sonore Web Audio : tempo + notes [{f,fEnd,d,g,type,v}]",
      "properties": {
        "tempo": { "type": "number" },
        "notes": { "type": "array", "minItems": 1 }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["q", "options", "reponse"],
        "properties": {
          "q": { "type": "string", "minLength": 5 },
          "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "reponse": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "pedagogie": { "$ref": "notion-guide.schema.json#/properties/pedagogie" }
  }
}
