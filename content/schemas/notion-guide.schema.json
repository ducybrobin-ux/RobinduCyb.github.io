{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jdpbc/schemas/notion-guide.schema.json",
  "title": "Notion du guide « L'esprit malin »",
  "type": "object",
  "required": ["id", "nom", "description", "pedagogie"],
  "additionalProperties": true,
  "properties": {
    "type": { "const": "notion-guide" },
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "nom": { "type": "string", "minLength": 1 },
    "latin": { "type": "string" },
    "emoji": { "type": "string" },
    "couleur": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "categorie": { "enum": ["diurne", "nocturne"] },
    "taille": { "type": "string", "description": "Antidote affiché" },
    "img": { "type": "string" },
    "description": { "type": "string", "minLength": 10 },
    "anecdotes": { "type": "array", "items": { "type": "string" } },
    "pedagogie": {
      "type": "object",
      "required": ["ages", "duree_min", "objectif"],
      "properties": {
        "ages": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "duree_min": { "type": "integer", "minimum": 1 },
        "objectif": { "type": "string", "minLength": 10 },
        "prerequis": { "type": "array", "items": { "type": "string" } },
        "programme": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
